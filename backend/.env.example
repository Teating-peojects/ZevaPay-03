# ZevaPay API — environment template
# Copy to `.env` and adjust. Never commit a real `.env`.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://zevapay:zevapay@localhost:5432/zevapay?schema=public"

# Change these in any shared or deployed environment.
JWT_SECRET="dev-only-secret-change-me-in-production-000000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000

# Shared secret the Android device / simulator uses when posting notifications.
DEVICE_INGEST_SECRET="dev-device-ingest-secret-change-me"

# Parser confidence at or above which a notification is auto-accepted.
AUTO_ACCEPT_CONFIDENCE=0.9

LOG_LEVEL=info
