# Origin of the ZevaPay API service.
# Used by the same-origin proxy at /api/v1/[...path] and by server-side calls.
API_URL=http://localhost:4000

# Public origin of the API, exposed to the browser for direct links.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Demo role switch.
#
# When set to "true", the sign-in page shows a Merchant/Admin switch that
# pre-fills a seeded account. It is ignored in a production build, and it
# never sets a session cookie — the switch only fills in the form, and the
# sign-in itself is a normal request to the real API.
